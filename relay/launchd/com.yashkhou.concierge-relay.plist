<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.yashkhou.concierge-relay</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key><string>__NODE_BIN__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key><string>__HOME__</string>
		<key>PORT</key><string>4630</string>
		<key>CONCIERGE_MODEL</key><string>sonnet</string>
		<key>MAX_CONCURRENT</key><string>3</string>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>__REPO__/relay/launchd/run-relay.sh</string>
	</array>
	<key>WorkingDirectory</key><string>__REPO__</string>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>ThrottleInterval</key><integer>10</integer>
	<key>StandardOutPath</key><string>__HOME__/Library/Logs/concierge/relay.log</string>
	<key>StandardErrorPath</key><string>__HOME__/Library/Logs/concierge/relay.err.log</string>
</dict>
</plist>
